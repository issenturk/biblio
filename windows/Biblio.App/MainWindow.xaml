<Window x:Class="Biblio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biblio" Width="760" Height="720" MinWidth="620" MinHeight="520" Icon="Assets/Biblio.ico">
    <TabControl x:Name="Tabs" Margin="8">
        <TabItem x:Name="TabRename">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="DropZone" Grid.Row="0" AllowDrop="True" Height="96" BorderBrush="#8896A5" BorderThickness="2" CornerRadius="10" Background="#F3F6F9"
                        Drop="DropZone_Drop" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave">
                    <TextBlock x:Name="DropText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="#44505C"/>
                </Border>
                <TextBlock x:Name="PreviewText" Grid.Row="1" Margin="0,6,0,6" HorizontalAlignment="Center" Foreground="#667" FontSize="12"/>
                <Border x:Name="PendingBanner" Grid.Row="2" Background="#FFF4D6" BorderBrush="#E0B84A" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
                    <DockPanel>
                        <Button x:Name="RetryBtn" DockPanel.Dock="Right" Padding="10,2" Click="Retry_Click"/>
                        <TextBlock x:Name="PendingText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <DockPanel Grid.Row="3" Margin="0,0,0,4">
                    <TextBlock x:Name="FoldersTitle" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="AddFolderBtn" DockPanel.Dock="Right" Padding="10,2" Click="AddFolder_Click"/>
                    <CheckBox x:Name="WatchCheck" DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center" Click="Watch_Click"/>
                    <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Margin="0,0,12,0" Foreground="#667" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </DockPanel>
                <ListBox x:Name="FolderList" Grid.Row="4" MaxHeight="90" Margin="0,0,0,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Click="RemoveFolder_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0"/>
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <DockPanel Grid.Row="5">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock x:Name="LogTitle" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="ClearBtn" DockPanel.Dock="Right" Padding="10,2" Click="Clear_Click"/>
                        <Button x:Name="UndoLastBtn" DockPanel.Dock="Right" Padding="10,2" Margin="0,0,8,0" Click="UndoLast_Click"/>
                        <TextBlock/>
                    </DockPanel>
                    <ListBox x:Name="LogList" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Top" Foreground="{Binding IconBrush}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding OldName}" TextTrimming="CharacterEllipsis" Foreground="#667" FontSize="12"/>
                                        <TextBlock Text="{Binding NewName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding HasNew}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#667" FontSize="11.5"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="{Binding EnterLabel}" Click="Enter_Click" Tag="{Binding}" Margin="0,0,6,0" Padding="8,1">
                                            <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding CanEnter}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <Button Content="{Binding UndoLabel}" Click="Undo_Click" Tag="{Binding}" Margin="0,0,6,0" Padding="8,1">
                                            <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding CanUndo}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <Button Content="✕" Click="RemoveRow_Click" Tag="{Binding}" Padding="6,0" Background="Transparent" BorderThickness="0" ToolTip="{Binding RemoveHelp}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </TabItem>
        <TabItem x:Name="TabRefs">
            <TextBlock x:Name="RefsText" Margin="20" TextWrapping="Wrap" FontSize="14" Foreground="#555"/>
        </TabItem>
        <TabItem x:Name="TabSettings">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SettingsPanel" Margin="14"/>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
