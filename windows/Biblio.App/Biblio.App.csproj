    <UseWPF>true</UseWPF>
    <AssemblyName>Biblio</AssemblyName>
    <RootNamespace>Biblio.App</RootNamespace>
    <ApplicationIcon>Assets\Biblio.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Biblio.Core\Biblio.Core.csproj" />
    <PackageReference Include="PDFtoImage" Version="5.1.1" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Biblio.ico" />
  </ItemGroup>
</Project>
